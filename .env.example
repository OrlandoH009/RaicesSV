# Local: mysql://usuario:password@localhost:3306/nombre_basedatos
# Producción (Vercel): connection string de TiDB Cloud Serverless, ej.
# mysql://usuario.root:PASSWORD@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/nombre_basedatos
DB_URL=

# Cloudflare R2 (almacenamiento de imágenes de publicaciones y avatares)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

OPENROUTER_API_KEY=
PORT=

NGROK_AUTHTOKEN=
NGROK_ENABLED=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recuperación de contraseña (Nodemailer / SMTP - Gmail)
# Para Gmail: crea una "Contraseña de aplicación" en tu cuenta de Google
# (Cuenta > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
# y úsala en SMTP_PASS; NO uses tu contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Tiles del mapa cultural (Stadia Maps) - el servidor la usa para pedir los
# tiles y nunca se expone al cliente; ver routes/tiles.routes.js
STADIA_API_KEY=