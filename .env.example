# Local: mysql://usuario:password@localhost:3306/nombre_basedatos
# Producción (Vercel): Service URI de Aiven, ej.
# mysql://avnadmin:PASSWORD@mysql-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
DB_URL=

OPENROUTER_API_KEY=
PORT=

NGROK_AUTHTOKEN=
NGROK_ENABLED=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Recuperación de contraseña (Nodemailer / SMTP - Gmail)
# Para Gmail: crea una "Contraseña de aplicación" en tu cuenta de Google
# (Cuenta > Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones)
# y úsala en SMTP_PASS; NO uses tu contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=